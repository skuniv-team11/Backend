      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "무엇과 무엇이 어떻게 다른지 한 문장"
          },
          "page_a": {
            "type": "integer"
          },
          "quote_a": {
            "type": "string"
          },
          "page_b": {
            "type": "integer"
          },
          "quote_b": {
            "type": "string"
          }
