{
  "type": "object",
  "properties": {
    "institution": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Sourced0",
          "description": "기관(법인)명"
        },
        "business_no": {
          "$ref": "#/$defs/Sourced0",
          "description": "사업자등록번호"
        },
        "opened_on": {
          "$ref": "#/$defs/Sourced0",
          "description": "개업년월일(적힌 그대로)"
        },
        "ksic_code": {
          "$ref": "#/$defs/Sourced0",
          "description": "한국표준산업분류코드. 쪽마다 다르면 첫 쪽 값을 넣고 inconsistencies에 기록"
        },
        "employees": {
          "$ref": "#/$defs/Sourced0",
          "description": "종업원 수(적힌 그대로)"
        },
        "size": {
          "$ref": "#/$defs/Sourced1",
          "description": "기관현황 규모 체크"
        },
        "listing": {
          "$ref": "#/$defs/Sourced2",
          "description": "상장여부 체크"
        },
        "selection_method": {
          "$ref": "#/$defs/Sourced0",
          "description": "전형방법"
        }
      },
      "required": [
        "name",
        "business_no",
        "opened_on",
        "ksic_code",
        "employees",
        "size",
        "listing",
        "selection_method"
      ],
      "additionalProperties": false
    },
    "jobs": {
      "type": "array",
      "description": "직무 1개 = 팀 1개. 직무기술서 블록의 부서명 칸에 팀이 여러 개 적혀 있으면 팀마다 1개(시스템 프롬프트 '직무(jobs) 나누기' 참고)",
      "items": {
        "type": "object",
        "properties": {
          "department": {
            "$ref": "#/$defs/Sourced0",
            "description": "부서명"
          },
          "job_title": {
            "$ref": "#/$defs/Sourced0",
            "description": "직무명"
          },
          "job_type": {
            "$ref": "#/$defs/Sourced3",
            "description": "운영유형 체크"
          },
          "period": {
            "$ref": "#/$defs/Sourced0",
            "description": "실습기간(연도 오기가 있어도 적힌 그대로)"
          },
          "hours": {
            "$ref": "#/$defs/Sourced0",
            "description": "정규실습 시간(적힌 그대로)"
          },
          "weekdays": {
            "$ref": "#/$defs/Sourced4",
            "description": "실습요일 중 체크된 요일"
          },
          "overtime": {
            "$ref": "#/$defs/Sourced5",
            "description": "연장실습 여부 체크"
          },
          "labor_contract": {
            "$ref": "#/$defs/Sourced6",
            "description": "별도 근로계약 체결 여부 체크"
          },
          "stipend_amount": {
            "$ref": "#/$defs/Sourced0",
            "description": "정규실습시간 실습지원비 금액(적힌 그대로, 예: 1,620,000)"
          },
          "benefits": {
            "$ref": "#/$defs/Sourced7",
            "description": "기타 지원 사항 중 체크된 항목"
          },
          "major_requirement": {
            "$ref": "#/$defs/Sourced0",
            "description": "학생요건의 전공(인원) 칸 원문 전체"
          },
          "headcount": {
            "$ref": "#/$defs/Sourced0",
            "description": "모집 인원(전공(인원) 칸 등에 적힌 그대로, 예: 1명)"
          },
          "grade_requirement": {
            "$ref": "#/$defs/Sourced0",
            "description": "학년 요건 원문"
          },
          "gpa_requirement": {
            "$ref": "#/$defs/Sourced0",
            "description": "학점/평점 요건 원문"
          },
          "portfolio": {
            "$ref": "#/$defs/Sourced8",
            "description": "포트폴리오: '필수/제출'이면 필수, '우대'면 우대, 언급 없으면 언급 없음"
          }
        },
        "required": [
          "department",
          "job_title",
          "job_type",
          "period",
          "hours",
          "weekdays",
          "overtime",
          "labor_contract",
          "stipend_amount",
          "benefits",
          "major_requirement",
          "headcount",
          "grade_requirement",
          "gpa_requirement",
          "portfolio"
        ],
        "additionalProperties": false
      }
    },
